{
  "name": "@ace-tracker/app",
  "private": true,
  "version": "0.1.0",
  "description": "Ace Tracker desktop application (Electron)",
  "author": "Ace Tracker",
  "repository": {
    "type": "git",
    "url": "https://github.com/FlyingV111/ace-tracker.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node -e \"const fs=require('fs');const p=require('path');const d=p.join(__dirname,'..','node_modules','electron');if(!fs.existsSync(p.join(d,'path.txt'))){require('child_process').execFileSync(process.execPath,[p.join(d,'install.js')],{stdio:'inherit'})}\"",
    "dev": "electron-vite dev",
    "dev:web": "vite",
    "build": "npm run typecheck && electron-vite build",
    "build:web": "npm run typecheck && vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b --pretty false",
    "package": "npm run build && electron-builder --dir --config electron-builder.yml",
    "package:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "package:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "package:linux": "npm run build && electron-builder --linux --config electron-builder.yml",
    "release:win": "npm run build && electron-builder --win --publish always --config electron-builder.yml",
    "lint": "oxlint"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "oxlint": "^1.81.0",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^7.3.6"
  }
}
